# Pipeline check for Qwen3-1.7B: 3 steps, tiny batch, 64 Spider-dev examples. Expect non-constant rewards.
MODEL=Qwen/Qwen3-1.7B
ENABLE_THINKING=False   # matches the model sweep (evals/spider_dev/qwen3-1.7b: 56.5% greedy)
NGPUS=4                 # Slurm allocation (GPUs 4-7)
TRAIN_BS=16
N=5
MAX_RESPONSE=8192
TOTAL_STEPS=3
TEST_FREQ=2
SAVE_FREQ=-1
VAL_FILE=$ROOT/data/verl/validation_64.parquet
