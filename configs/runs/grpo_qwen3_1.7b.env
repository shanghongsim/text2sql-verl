# Real GRPO run: Qwen3-1.7B (non-thinking), SkyRL-SQL recipe, 4 GPUs (Slurm GPUs 4-7).
# SkyRL: batch 256 = mini 256 (1 on-policy update/step), n=5, lr 1e-6, 30 epochs, eval every 5 steps.
# 653 train ex / 256 -> 2 steps/epoch -> ~60 steps.
MODEL=Qwen/Qwen3-1.7B
ENABLE_THINKING=False
NGPUS=4
TRAIN_BS=256
N=5
LR=1e-6
MAX_RESPONSE=8192       # all turns; smoke: mean a few hundred tokens, ~1% hit the cap
EPOCHS=30
TEST_FREQ=5             # full Spider dev (1034, greedy)
SAVE_FREQ=20
