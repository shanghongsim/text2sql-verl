+def compute_group_signal_metrics(uids, seq_rewards, prefix: str = "training/groups") -> dict:
+    """text2sql local patch: share of GRPO groups that carry no learning signal.
+
+    A group = all samples sharing a prompt `uid` (the grouping GRPO uses). If every sample in a group has
+    the same sequence reward, every advantage is 0 and the group adds no gradient. Splits those groups by
+    the common reward's sign (for a -1/0/+1 reward: no submit / wrong / correct).
+    """
+    groups = defaultdict(list)
+    for uid, r in zip(uids, seq_rewards, strict=True):
+        groups[uid].append(float(r))
+    n = max(len(groups), 1)
+    zero_var = [v[0] for v in groups.values() if max(v) - min(v) < 1e-6]
+    return {
+        f"{prefix}/num_groups": len(groups),
+        f"{prefix}/zero_variance_frac": len(zero_var) / n,
+        f"{prefix}/all_positive_frac": sum(r > 0 for r in zero_var) / n,
+        f"{prefix}/all_zero_frac": sum(r == 0 for r in zero_var) / n,
+        f"{prefix}/all_negative_frac": sum(r < 0 for r in zero_var) / n,
+    }
+
